# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
dist/
*.egg-info/

# Devtool runtime state
# Keep the artifact registry commit-safe while ignoring all other local state.
.devtool/*
!.devtool/artifacts.json
!.devtool/artifacts.d/
!.devtool/artifacts.d/**
**/android-live-hud.token

# .NET and Gradle outputs
**/bin/
**/obj/
**/.gradle/
**/build/

# Android packages are generated except for the tracked debug HUD artifact.
*.apk
*.aab
!android/devtool-live-hud/devtool-live-hud-debug.apk

# Local Android SDK paths
**/local.properties

# Root bridge source is tracked even though generated build directories are ignored.
!root-module/devtool-bridge/bin/
!root-module/devtool-bridge/bin/devtool-root-bridge
