    "success": [
      "Open app",
      "Copy summary",
      "Dismiss"
    ],
    "failed": [
      "Open log",
      "Copy error",
      "Retry"
    ],
    "rollback": [
      "Open log",
      "Copy status",
      "Keep visible"
    ],
    "recovered": [
      "Open log",
      "Copy summary",
