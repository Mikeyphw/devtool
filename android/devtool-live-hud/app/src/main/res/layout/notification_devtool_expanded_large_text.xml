<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/notification_root" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:background="@drawable/notification_card_running">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingTop="11dp" android:paddingEnd="14dp" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <ImageView android:id="@+id/notification_app_icon" android:layout_width="34dp" android:layout_height="34dp" android:padding="8dp" android:src="@drawable/ic_devtool_notification" android:tint="@color/notification_running" android:background="@drawable/notification_badge_running" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="9dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                    <TextView style="@style/TextAppearance.Devtool.Notification.Detail" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Devtool" android:textColor="@color/notification_text" android:fontFamily="sans-serif-medium" />
                    <ImageView android:id="@+id/notification_state_dot" android:layout_width="10dp" android:layout_height="10dp" android:layout_marginStart="6dp" android:src="@drawable/ic_notification_state_dot" android:tint="@color/notification_running" android:contentDescription="@null" />
                    <TextView android:id="@+id/notification_state_label" style="@style/TextAppearance.Devtool.Notification.Badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:text="LIVE" android:letterSpacing="0.04" />
                </LinearLayout>
                <TextView android:id="@+id/notification_task_title" style="@style/TextAppearance.Devtool.Notification.Title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/notification_progress_label" style="@style/TextAppearance.Devtool.Notification.Workspace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textColor="@color/notification_running" />
        </LinearLayout>
        <ProgressBar android:id="@+id/notification_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_marginTop="7dp" android:max="100" android:progressTint="@color/notification_running" android:progressBackgroundTint="#3A3E47" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="8dp" android:layout_marginBottom="3dp">
            <TextView android:id="@+id/notification_artifact" style="@style/TextAppearance.Devtool.Notification.Detail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/notification_workspace_name" style="@style/TextAppearance.Devtool.Notification.Workspace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/notification_workspace_index" style="@style/TextAppearance.Devtool.Notification.Badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:minHeight="24dp" android:gravity="center" android:paddingStart="8dp" android:paddingEnd="8dp" android:textColor="@color/notification_muted" android:background="@drawable/notification_chip" />
        </LinearLayout>
        <LinearLayout android:id="@+id/notification_phase_row_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
        <ImageView android:id="@+id/notification_phase_mark_1" android:layout_width="18dp" android:layout_height="18dp" android:padding="3dp" android:src="@drawable/ic_phase_pending" android:tint="@color/notification_soft" android:background="@drawable/notification_mark_pending" android:contentDescription="@null" />
        <TextView android:id="@+id/notification_phase_name_1" style="@style/TextAppearance.Devtool.Notification.Workspace" android:layout_width="76dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/notification_phase_detail_1" style="@style/TextAppearance.Devtool.Notification.Detail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
        <LinearLayout android:id="@+id/notification_phase_row_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
        <ImageView android:id="@+id/notification_phase_mark_2" android:layout_width="18dp" android:layout_height="18dp" android:padding="3dp" android:src="@drawable/ic_phase_pending" android:tint="@color/notification_soft" android:background="@drawable/notification_mark_pending" android:contentDescription="@null" />
        <TextView android:id="@+id/notification_phase_name_2" style="@style/TextAppearance.Devtool.Notification.Workspace" android:layout_width="76dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/notification_phase_detail_2" style="@style/TextAppearance.Devtool.Notification.Detail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
        <LinearLayout android:id="@+id/notification_phase_row_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp" android:visibility="gone">
        <ImageView android:id="@+id/notification_phase_mark_3" android:layout_width="18dp" android:layout_height="18dp" android:padding="3dp" android:src="@drawable/ic_phase_pending" android:tint="@color/notification_soft" android:background="@drawable/notification_mark_pending" android:contentDescription="@null" />
        <TextView android:id="@+id/notification_phase_name_3" style="@style/TextAppearance.Devtool.Notification.Workspace" android:layout_width="76dp" android:layout_height="wrap_content" android:layout_marginStart="7dp" android:maxLines="2" android:ellipsize="end" />
        <TextView android:id="@+id/notification_phase_detail_3" style="@style/TextAppearance.Devtool.Notification.Detail" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="9dp" android:paddingTop="6dp" android:paddingEnd="9dp" android:paddingBottom="6dp" android:layout_marginTop="5dp" android:background="@drawable/notification_workspace">
            <ImageView android:id="@+id/notification_workspace_mark" android:layout_width="18dp" android:layout_height="18dp" android:padding="3dp" android:src="@drawable/ic_phase_active" android:tint="@color/notification_running" android:background="@drawable/notification_mark_active" android:contentDescription="@null" />
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="8dp">
                <TextView android:id="@+id/notification_workspace_current" style="@style/TextAppearance.Devtool.Notification.Workspace" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
                <TextView android:id="@+id/notification_workspace_meta" style="@style/TextAppearance.Devtool.Notification.Detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" />
            </LinearLayout>
            <TextView android:id="@+id/notification_workspace_progress" style="@style/TextAppearance.Devtool.Notification.Workspace" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:textColor="@color/notification_soft" />
        </LinearLayout>
        <TextView android:id="@+id/notification_workspace_remaining" style="@style/TextAppearance.Devtool.Notification.Detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="2" android:ellipsize="end" android:textColor="@color/notification_soft" />
        <TextView android:id="@+id/notification_metrics_summary" style="@style/TextAppearance.Devtool.Notification.Detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:maxLines="3" android:ellipsize="end" android:textColor="@color/notification_text" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/notification_line" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:orientation="horizontal">
        <TextView android:id="@+id/notification_action_1" style="@style/TextAppearance.Devtool.Notification.Action" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/notification_action" />
        <TextView android:id="@+id/notification_action_2" style="@style/TextAppearance.Devtool.Notification.Action" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/notification_action" />
        <TextView android:id="@+id/notification_action_3" style="@style/TextAppearance.Devtool.Notification.Action" android:layout_width="0dp" android:layout_height="wrap_content" android:minHeight="48dp" android:layout_weight="1" android:gravity="center" android:paddingStart="4dp" android:paddingEnd="4dp" android:background="@drawable/notification_action" />
    </LinearLayout>
</LinearLayout>
