<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Devtool HUD stores debug traces, bridge metadata, repositories, and support bundles locally.
         Keep them out of legacy Auto Backup as well as Android 12+ data extraction. -->
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
