<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <queries>
        <package android:name="com.termux" />
        <package android:name="net.dinglisch.android.taskerm" />
        <package android:name="net.dinglisch.android.tasker" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevtoolHud">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".LogViewerActivity"
            android:exported="true"
            android:label="Devtool Log">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="devtool" android:host="logs" android:pathPrefix="/run/" />
            </intent-filter>
        </activity>

        <activity
            android:name=".DebugWorkbenchActivity"
            android:exported="false"
            android:label="Debug Workbench" />

        <activity
            android:name=".ValidationEvidenceActivity"
            android:exported="false"
            android:label="Validation Evidence" />

        <activity
            android:name=".RepositoryDetailActivity"
            android:exported="false"
            android:label="Repository" />

        <activity
            android:name=".RepositoryPickerActivity"
            android:exported="false"
            android:label="Choose Repository" />

        <activity
            android:name=".GitDiffActivity"
            android:exported="false"
            android:label="Git Diff" />

        <activity
            android:name=".GitCommitActivity"
            android:exported="false"
            android:label="Commit Details" />

        <activity
            android:name=".TaskerPluginActivity"
            android:exported="true"
            android:label="@string/tasker_action_name"
            android:theme="@style/Theme.DevtoolHud">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.EDIT_SETTING" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".OverlayHudService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-enabled developer build, test, validation and commit progress overlay." />
        </service>

        <service
            android:name=".TermuxResultService"
            android:enabled="true"
            android:exported="false" />

        <!-- Exported for Tasker Locale FIRE_SETTING broadcasts; runtime config authorization is enforced in TaskerPluginReceiver. -->
        <receiver
            android:name=".TaskerPluginReceiver"
            android:enabled="true"
            android:exported="true"
            android:label="@string/tasker_action_name"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.twofortyfouram.locale.intent.action.FIRE_SETTING" />
            </intent-filter>
        </receiver>

        <!-- Exported for Termux/root bridge callbacks; BridgeReceiver rejects invalid tokens and unexpected actions. -->
        <receiver
            android:name=".BridgeReceiver"
            android:enabled="true"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="${applicationId}.UPDATE" />
                <action android:name="${applicationId}.COMPLETE" />
                <action android:name="${applicationId}.FAIL" />
                <action android:name="${applicationId}.CANCEL" />
                <action android:name="${applicationId}.TOAST" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".ActionReceiver"
            android:enabled="true"
            android:exported="false" />
    </application>
</manifest>
