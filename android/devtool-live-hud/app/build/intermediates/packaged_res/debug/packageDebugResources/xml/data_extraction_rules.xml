<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Devtool HUD stores run traces, repository paths, bridge metadata, and support-bundle state.
         Backups are disabled and device/cloud transfer is explicitly excluded to keep debug evidence local. -->
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
