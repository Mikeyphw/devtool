<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/notification_card" />
            <stroke android:width="1dp" android:color="@color/notification_warning" />
            <corners android:radius="18dp" />
        </shape>
    </item>
    <item android:width="3dp" android:gravity="start">
        <shape android:shape="rectangle">
            <solid android:color="@color/notification_warning" />
            <corners android:topLeftRadius="18dp" android:bottomLeftRadius="18dp" />
        </shape>
    </item>
</layer-list>
