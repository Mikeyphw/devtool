#!/bin/sh
# DEVTOOL_WRAPPER_LAUNCHER=1
# Generated by `devtool wrapper init/update`. Do not edit by hand.
set -eu

script="$0"
# Resolve one level of symlink when readlink is available; this keeps the
# launcher useful when copied or symlinked by repo bootstrap tooling without
# requiring non-portable readlink -f.
if command -v readlink >/dev/null 2>&1 && [ -L "$script" ]; then
    link_target=$(readlink "$script" || true)
    case "$link_target" in
        /*) script="$link_target" ;;
        ?*) script="$(dirname -- "$script")/$link_target" ;;
    esac
fi

script_dir=$(dirname -- "$script")
repo_root=$(CDPATH= cd -- "$script_dir" 2>/dev/null && pwd -P) || exit 1
exec devtool --repo "$repo_root" wrapper exec "$@"
